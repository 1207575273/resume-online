# 慢网络容忍（HK→npmjs 偶发劣化）：单请求 10 分钟超时、5 次重试、退避起步 10s
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
# 收敛并发，避免大量同时连接触发对端重置
network-concurrency=2
# 源选择：官方 registry 的 tarball CDN（Cloudflare）在 HK 反而比 npmmirror 的阿里 OSS 稳；
# metadata 供应链查询已用 --trust-lockfile 跳过（Dockerfile），故保留官方源
# pnpm 11 默认供应链检查需在线查询全部依赖的发布元数据，网络劣化时必挂（曾报
# "Lockfile failed supply-chain policy check (310 entries)"）；个人项目关闭
minimum-release-age=0
