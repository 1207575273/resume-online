# ===== 数据库（compose 与本地开发共用）=====
POSTGRES_USER=resume
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=resume
DATABASE_URL=postgresql://resume:change-me-please@localhost:5432/resume

# ===== server =====
# 容器内为 http://db:5432 形式的连接串，见 deploy/compose.yaml
PORT=3001
# 写接口保护令牌（创建/发布版本），script/gen-env.sh 会自动生成
INTERNAL_API_TOKEN=change-me-too

# ===== 日志（pino）=====
# 控制台固定 JSONL；文件为人类可读格式、按天轮转
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=14
# LOG_FILE=false 可关闭文件日志（容器内已挂载 /app/logs，一般无需关闭）

# ===== web =====
# 前端服务端取数地址：本地开发指向本机，容器内为 http://server:3001/api/v1
RESUME_API_BASE=http://localhost:3001/api/v1

# ===== 生产部署（仅 deploy:prod 使用）=====
DOMAIN=resume.example.com
ACME_EMAIL=you@example.com
