# ===== 数据库（compose 与本地开发共用）=====
POSTGRES_USER=resume
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=resume
DATABASE_URL=postgresql://resume:change-me-please@localhost:5432/resume

# ===== server =====
# 容器内为 http://db:5432 形式的连接串，见 deploy/compose.yaml
PORT=3001
# 写接口保护令牌（创建/发布版本），script/gen-env.sh 会自动生成
INTERNAL_API_TOKEN=change-me-too

# ===== 日志（pino）=====
# 控制台固定 JSONL；文件为人类可读格式、按天轮转
LOG_LEVEL=info
LOG_DIR=logs
LOG_RETENTION_DAYS=14
# LOG_FILE=false 可关闭文件日志（容器内已挂载 /app/logs，一般无需关闭）

# ===== web =====
# 前端服务端取数地址：本地开发指向本机，容器内为 http://server:3001/api/v1
RESUME_API_BASE=http://localhost:3001/api/v1

# ===== chat（AI 问答网关）=====
# admin 管理接口令牌（请求头 x-admin-token），script/gen-env.sh 会自动生成
CHAT_ADMIN_TOKEN=change-me-chat
# claude CLI 使用的模型（可换 glm 等，取决于 provider）
CHAT_MODEL=sonnet
# claude CLI 鉴权：走第三方 provider 时配 BASE_URL + AUTH_TOKEN/API_KEY，留空则用官方默认
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# ===== 生产部署（仅 deploy:prod 使用）=====
DOMAIN=resume.example.com
ACME_EMAIL=you@example.com
# 百度普通收录 API 推送 token（ziyuan.baidu.com → 普通收录 → API 推送）；
# 留空/未配时 baidu-push.mjs 安静跳过，配置后 release.mjs 发布完自动推送
# BAIDU_PUSH_TOKEN=
